{
  "manifest_version": 3,
  "name": "Agent Automation",
  "version": "0.0.0",
  "description": "Side-panel AI agent that automates your browser using a local model (LM Studio, Ollama) or any cloud API provider.",
  "homepage_url": "https://github.com/cyberkyd01/agent-automation",
  "browser_specific_settings": {
    "gecko": {
      "id": "agent-automation@cyberkyd01.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab",
    "scripting",
    "downloads",
    "declarativeNetRequestWithHostAccess",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "page": "background.html"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "Agent Automation",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "action": {
    "default_title": "Open Agent Automation",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open or close the Agent Automation sidebar"
    }
  }
}
