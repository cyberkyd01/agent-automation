{
  "manifest_version": 3,
  "name": "Agent Automation",
  "version": "1.2.0",
  "description": "Side-panel AI agent that automates your browser using a local model (LM Studio, Ollama) or any cloud API provider.",
  "homepage_url": "https://github.com/cyberkyd01/agent-automation",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "debugger",
    "downloads",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Agent Automation" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" }
    }
  }
}
